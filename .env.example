# ---------------------------------------------------------------------------
# AKIRA Ops Suite — web environment
# Copy to .env.local. Vite only exposes variables prefixed VITE_.
#
# Everything here ships inside the JavaScript bundle. Never put a secret in
# this file — no service-role key, no database URL, no signing secret.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Used for exactly three things: the auth session, direct-to-Storage uploads
# via a signed URL the API minted, and realtime subscriptions. Application
# data is never read through this client. See CLAUDE.md.
VITE_SUPABASE_URL=https://zvskxgmmlahhybzpcicl.supabase.co

# The publishable key is designed to be public — it is the anon identity, and
# RLS plus the API's authorisation checks are what actually protect data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ySp9Uovntyxh9nJ-QuNm-Q_I40WS4y_

# --- API ------------------------------------------------------------------
# The FastAPI backend. All business data comes from here.
# Production: the deployed API's https origin, set in the host's build
# environment (Vercel/Netlify/Cloudflare project settings), never committed.
VITE_API_BASE_URL=http://localhost:8000
